# Database
DATABASE_URL=postgresql://aicw:aicw_dev_password@localhost:5432/aicw?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=aicw_minio
S3_SECRET_KEY=aicw_minio_secret
S3_BUCKET=aicw-files
S3_REGION=us-east-1

# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_2FA_TTL=5m

# Email (optional — logs to console in dev without SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Frontend URLs (for CORS)
WEB_CLIENT_URL=http://localhost:5173
WEB_ADMIN_URL=http://localhost:5174
WIDGET_URL=http://localhost:5175

# Embeddings (optional — mock vectors used when unset)
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# LLM providers (mock used as fallback when keys unset)
# LLM_PROVIDER_CHAIN=deepseek,openai,anthropic,mock
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# OPENAI_MODEL=gpt-4o-mini
# GLOBAL_SYSTEM_PROMPT=Ты — вежливый ИИ-консультант...

# Widget rate limiting
# WIDGET_RATE_LIMIT_MAX=10
# WIDGET_RATE_LIMIT_WINDOW_MS=60000

# Playground daily limit per tenant
# PLAYGROUND_DAILY_LIMIT=100

# CRM lead deduplication window (days)
# LEAD_DEDUPE_DAYS=30

# YooKassa integration (Sprint 8)
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET_KEY=your_secret_key
# YOOKASSA_RETURN_URL=http://localhost:5173/billing/success

# Semantic cache (Sprint 9)
# SEMANTIC_CACHE_THRESHOLD=0.92
# SEMANTIC_CACHE_TTL_HOURS=168

# Margin analytics USD→RUB conversion
# USD_RUB_RATE=90

# Analytics offline conversions (Sprint 10) — optional custom fetch for tests
# CONVERSION_FETCH is injected at runtime in unit tests only

# CRM integrations (Sprint 11)
# INTEGRATION_ENCRYPTION_KEY=change-me-32-chars-minimum-secret
# TWO_FA_SECRET_KEY=change-me-32-chars-minimum-secret
# API_PUBLIC_URL=http://localhost:3000/api
# AMOCRM_CLIENT_ID=
# AMOCRM_CLIENT_SECRET=
# AMOCRM_REDIRECT_URI=http://localhost:3000/api/integrations/amocrm/callback
# BITRIX24_CLIENT_ID=
# BITRIX24_CLIENT_SECRET=
# BITRIX24_REDIRECT_URI=http://localhost:3000/api/integrations/bitrix24/callback

# Deploy / updates (Sprint 14)
# COOKIE_SECURE=false  # required for HTTP deploy without SSL
# APP_VERSION=0.33.0
# SPRINT_NUMBER=33
# RELEASE_DEPLOY_TOKEN=change_me_release_token
# DEPLOY_MODE=script
# HOST_INSTALL_DIR=/opt/monstro_chat_ai
# DEPLOY_HEALTH_URL=http://localhost:3000/api/health
# BACKUP_MODE=mock
# BACKUP_DIR=./backups
# IMPERSONATION_TTL_SEC=3600
# E2E_BASE_URL=http://localhost:3000
# E2E_MODE=skip

# Analytics cache (Sprint 15)
# ANALYTICS_CACHE_TTL_SEC=600

# Public site (Sprint 16)
# PUBLIC_SITE_URL=http://localhost:4321
# API_INTERNAL_URL=http://localhost:3000
# API_PUBLIC_URL=http://localhost:3000/api
# NEXT_PUBLIC_SITE_URL=http://localhost:4321
# NEXT_PUBLIC_CLIENT_URL=http://localhost:5173
# NEXT_PUBLIC_WIDGET_URL=http://localhost:5175
# NEXT_PUBLIC_API_URL=http://localhost:4321/api
# DEMO_WIDGET_KEY=

# Audit hardening
# YOOKASSA_WEBHOOK_SECRET=change-me-in-production
# WIDGET_CORS_ORIGINS=http://localhost:4321,http://localhost:5173
