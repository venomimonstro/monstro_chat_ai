# Reference nginx: HTTPS widget + API WebSocket
#
# Place under /etc/nginx/sites-available/redflow-widget and enable.
# Replace HOSTNAME / upstreams for your server.

upstream aicw_api {
  server 127.0.0.1:3000;
  keepalive 32;
}

upstream aicw_widget {
  server 127.0.0.1:5175;
  keepalive 16;
}

server {
  listen 443 ssl http2;
  server_name chat.example.com;  # or redflow.ru

  # ssl_certificate /etc/letsencrypt/live/.../fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/.../privkey.pem;

  # Widget static + iframe
  location / {
    proxy_pass http://aicw_widget;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # API + Socket.IO (critical: Upgrade headers)
  location /api/ {
    proxy_pass http://aicw_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass http://aicw_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }
}
